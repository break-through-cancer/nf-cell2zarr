nextflow_process {

    name "Test Process BUILD_STRATA"
    script "modules/local/build_strata.nf"
    process "BUILD_STRATA"

    test("stub emits the store with an atomic strata group") {
        tag "stub"
        options "-stub"

        when {
            params {
                atomic_axes = "cell_type,treatment"
                coarse      = "cell_type;cell_type,treatment"
            }
            process {
                """
                input[0] = [ [id: 'tiny'], file("${projectDir}/tests/data/tiny.zarr") ]
                """
            }
        }

        then {
            assert process.success
            assert path("${process.out.zarr[0][1]}/uns/strata/atomic").exists()
        }
    }

    test("builds strata for the fixture's categorical columns") {
        tag "container"

        setup {
            run("CONVERT") {
                script "modules/local/convert.nf"
                process {
                    """
                    input[0] = [ [id: 'tiny'], file("${projectDir}/tests/data/tiny.h5ad") ]
                    """
                }
            }
            run("CONSOLIDATE") {
                script "modules/local/consolidate.nf"
                process {
                    """
                    input[0] = CONVERT.out.zarr
                    input[1] = []
                    """
                }
            }
        }

        when {
            params {
                atomic_axes = "cell_type,treatment"
                coarse      = "cell_type;cell_type,treatment"
            }
            process {
                """
                input[0] = CONSOLIDATE.out.zarr
                """
            }
        }

        then {
            assert process.success
            assert path("${process.out.zarr[0][1]}/uns/strata/atomic").exists()
        }
    }
}
