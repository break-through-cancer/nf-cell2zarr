nextflow_workflow {

    name "Test full pipeline"
    script "main.nf"
    workflow "NF_CELL2ZARR"

    test("rejects a non-h5ad input") {
        tag "stub"
        options "-stub"

        when {
            params {
                input = "${projectDir}/tests/data/tiny.loom"
            }
        }

        then {
            assert workflow.failed
            // Nextflow 26 on Linux prints a workflow `error` to stderr; 25.x and
            // macOS print it to stdout. Accept either stream.
            assert workflow.stdout.any { it.contains('.h5ad input only') } ||
                   workflow.stderr.any { it.contains('.h5ad input only') } ||
                   workflow.errorReport.contains('.h5ad input only')
        }
    }

    test("without strata axes the run ends at CONSOLIDATE") {
        tag "stub"
        options "-stub"

        when {
            params {
                input       = "${projectDir}/tests/data/tiny.h5ad"
                add_layers  = "counts"
                atomic_axes = null
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { it.name.contains('CONVERT') }
            assert workflow.trace.tasks().any { it.name.contains('ADD_LAYER') }
            assert workflow.trace.tasks().any { it.name.contains('CONSOLIDATE') }
            assert !workflow.trace.tasks().any { it.name.contains('BUILD_STRATA') }
        }
    }

    test("with strata axes BUILD_STRATA runs") {
        tag "stub"
        options "-stub"

        when {
            params {
                input       = "${projectDir}/tests/data/tiny.h5ad"
                add_layers  = null
                atomic_axes = "cell_type"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { it.name.contains('BUILD_STRATA') }
            assert !workflow.trace.tasks().any { it.name.contains('ADD_LAYER') }
        }
    }

    test("prepare=true runs PREPARE ahead of CONVERT") {
        tag "stub"
        options "-stub"

        when {
            params {
                input       = "${projectDir}/tests/data/tiny_merge.h5ad"
                outdir      = "${outputDir}"
                prepare     = true
                prepare_container = 'example.invalid/nf-cell2zarr-prepare:stub'
                add_layers  = null
                atomic_axes = null
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { it.name.contains('PREPARE') }
            assert workflow.trace.tasks().any { it.name.contains('CONVERT') }
            assert path("${outputDir}/prepared/provenance.json").exists()
        }
    }

    test("prepare=false (the default) never runs PREPARE") {
        tag "stub"
        options "-stub"

        when {
            params {
                input       = "${projectDir}/tests/data/tiny.h5ad"
                prepare     = false
                add_layers  = null
                atomic_axes = null
            }
        }

        then {
            assert workflow.success
            assert !workflow.trace.tasks().any { it.name.contains('PREPARE') }
        }
    }

    test("prepare=true with the placeholder image tag stops early") {
        tag "stub"
        options "-stub"

        when {
            params {
                input       = "${projectDir}/tests/data/tiny_merge.h5ad"
                outdir      = "${outputDir}"
                prepare     = true
                add_layers  = null
                atomic_axes = null
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains('PREPARE image tag has not been set') } ||
                   workflow.stderr.any { it.contains('PREPARE image tag has not been set') }
            assert !workflow.trace.tasks().any { it.name.contains('PREPARE') }
        }
    }
}
