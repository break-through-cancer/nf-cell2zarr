manifest {
    name            = 'nf-cell2zarr'
    description     = 'Convert single-cell h5ad datasets to Zarr v3 for cell-explorer'
    homePage        = 'https://github.com/break-through-cancer/nf-cell2zarr'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    input                  = null
    outdir                 = 'results'

    // prepare (optional): embed and annotate a raw merge before conversion.
    // Defaults are the GBM merge's.
    prepare                = false
    // Pinned by digest, so a re-run of the publish workflow that overwrites the
    // sha- tag cannot change the image silently. The digest is tag sha-b1923f2.
    // Digest only: Nextflow's AWS Batch executor rejects tag@digest.
    prepare_container      = 'ghcr.io/break-through-cancer/nf-cell2zarr-prepare@sha256:be57110e80884d6edf2d90f1b0b631d26dd9fc93d0ecdc2c44438245ada089fb'
    n_hvg                  = 3000
    n_pcs                  = 50
    n_neighbors            = 15
    leiden_resolution      = 1.0
    library_column         = 'orig.ident'
    site_regex             = '(DFCI-?\\d+|JHU\\d+|MSK\\d+|GBM-001)'
    patient_regex          = 'GBM-001-(\\d{3})'
    patient_prefix         = 'GBM001-P'
    tcr_column             = 'tcr_has_tcr_match'

    // conversion
    two_phase              = true
    cell_chunk_size        = 10000
    var_chunk_size         = 1
    shard_size             = 30
    dtype                  = 'float16'
    sparse_format          = 'csr'
    n_top_genes            = null
    normalize              = false
    obsm_cell_chunk_size   = null
    encoding_config        = null

    // layers are the only keys `cell2zarr convert` does not already write
    add_layers             = null

    // strata (optional)
    atomic_axes            = null
    coarse                 = null
    max_atomic_cardinality = null
}

process {
    // Pinned to the immutable sha- tag, not a version tag. The image tag tracks the
    // API version, so a release that does not bump the API republishes the SAME
    // version tag with different content — ghcr 0.5.1 was overwritten in place on
    // 2026-08-24. Pinned by digest, which even a re-pushed sha- tag cannot move.
    // The digest is tag sha-a35b938 (cell2zarr 0.4.2): the commit iris used for
    // the published GBM store, and the first with the pandas 3 / anndata 0.13
    // fixes the PREPARE output needs. Digest only: Nextflow's AWS Batch executor
    // rejects tag@digest (ContainerNameValidator).
    container = 'ghcr.io/cbioportal/cell-explorer-py@sha256:13674b9c2edd2c62a271965e73fd75ecd3ffb3ad434767be25ca2cfdddfa25ee'

    // `path` must be a closure. This process block is parsed before the `profiles`
    // block below, so reading params.outdir eagerly captures the default and ignores
    // any value a profile sets — a -profile test run published to results/ instead
    // of results-test/. A closure defers the read until publish time.
    withName: PREPARE {
        publishDir = [ path: { "${params.outdir}/prepared" }, mode: 'copy' ]
    }
    withName: CONSOLIDATE {
        publishDir = params.atomic_axes ? [] : [ path: { params.outdir }, mode: 'copy' ]
    }
    withName: BUILD_STRATA {
        publishDir = [ path: { params.outdir }, mode: 'copy' ]
    }
}

profiles {
    docker { docker.enabled = true }
    test   { includeConfig 'conf/test.config' }
}

includeConfig 'conf/base.config'
