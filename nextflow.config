manifest {
    name            = 'nf-cell2zarr'
    description     = 'Convert single-cell h5ad datasets to Zarr v3 for cell-explorer'
    homePage        = 'https://github.com/cBioPortal/nf-cell2zarr'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    input                  = null
    outdir                 = 'results'

    // conversion
    two_phase              = true
    cell_chunk_size        = 10000
    var_chunk_size         = 1
    shard_size             = 30
    dtype                  = 'float16'
    sparse_format          = 'csr'
    n_top_genes            = null
    normalize              = false
    obsm_cell_chunk_size   = null
    encoding_config        = null

    // supplementary keys
    add_keys               = 'obs,var,obsm'
    add_layers             = null

    // strata (optional)
    atomic_axes            = null
    coarse                 = null
    max_atomic_cardinality = null
}

process {
    container = 'ghcr.io/cbioportal/cell-explorer-py:0.5.1'

    withName: CONSOLIDATE {
        publishDir = params.atomic_axes ? [] : [ path: params.outdir, mode: 'copy' ]
    }
    withName: BUILD_STRATA {
        publishDir = [ path: params.outdir, mode: 'copy' ]
    }
}

profiles {
    docker { docker.enabled = true }
    test   { includeConfig 'conf/test.config' }
}

includeConfig 'conf/base.config'
