process {
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: process_convert {
        cpus   = 16
        memory = 128.GB
        time   = 48.h
    }
    withLabel: process_prepare {
        cpus   = 16
        memory = 240.GB  // AWS Batch cannot place a 256 GiB request on a 256 GiB host
        time   = 12.h
        // Only retry what a bigger/other host might fix (OOM-kill, SIGSEGV,
        // SIGTERM/spot reclaim, Batch-level failures). A check failure or
        // KeyError would just burn another multi-hour 36 GB run.
        errorStrategy = { task.exitStatus in [137, 139, 143] || task.exitStatus > 255 ? 'retry' : 'terminate' }
        maxRetries    = 1
    }
    withLabel: process_add_small {
        cpus   = 2
        memory = 16.GB
        time   = 4.h
    }
    withLabel: process_add_large {
        cpus   = 8
        memory = 64.GB
        time   = 24.h
    }
    withLabel: process_strata {
        cpus   = 8
        memory = 64.GB
        time   = 12.h
    }
}
