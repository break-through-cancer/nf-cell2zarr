process {
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: process_convert {
        cpus   = 16
        memory = 128.GB
        time   = 48.h
    }
    withLabel: process_add_small {
        cpus   = 2
        memory = 16.GB
        time   = 4.h
    }
    withLabel: process_add_large {
        cpus   = 8
        memory = 64.GB
        time   = 24.h
    }
    withLabel: process_strata {
        cpus   = 8
        memory = 64.GB
        time   = 12.h
    }
}
