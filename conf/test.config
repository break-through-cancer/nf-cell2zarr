params {
    input           = "${projectDir}/tests/data/tiny.h5ad"
    outdir          = 'results-test'
    cell_chunk_size = 50
    var_chunk_size  = 1
    shard_size      = 10
    dtype           = 'float32'
    add_layers      = 'counts'
    n_hvg           = 20
    n_pcs           = 10
    n_neighbors     = 10
}

process {
    // Clamps every process, including ones matched by the withLabel selectors in
    // conf/base.config. A plain `cpus = 2` here would NOT: withLabel is the more
    // specific selector and wins, so process_convert would still ask for 16 CPUs
    // and fail on any machine (or CI runner) with fewer.
    resourceLimits = [ cpus: 2, memory: 4.GB, time: 1.h ]
}
