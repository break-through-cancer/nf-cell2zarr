// Compute configuration applied by Cirro on top of the pipeline's own
// nextflow.config. Keep this file limited to executor and queue concerns —
// the container and the resource labels are pipeline-intrinsic and live in
// nextflow.config and conf/base.config.

process {
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
}
